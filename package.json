{
  "name": "blook-address-form",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/run.mjs vite build --configLoader native",
    "preview": "node scripts/run.mjs vite preview --host 127.0.0.1",
    "test": "vitest run",
    "deploy": "npm run build && node scripts/run.mjs wrangler deploy",
    "data:check": "node scripts/geography.mjs --check",
    "cf:login": "node scripts/run.mjs wrangler login",
    "cf:whoami": "node scripts/run.mjs wrangler whoami"
  },
  "dependencies": {
    "@line/liff": "2.31.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261011.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}

