    {
      "id": "8b11f422-6494-4903-ab35-5c1216a68cc1",
      "name": "Validate Address",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        208
      ],
      "parameters": {
        "jsCode": "const f=$('Check LINE Identity').item.json;const r=$input.first().json;const errors=[];const replay=r.status==='submitted';if(r.lineUserId!==f.lineUserId||!r.token||!r.lineUserId||(!replay&&r.status!=='pending')||(!replay&&(!Number.isFinite(Date.parse(r.expiresAt))||Date.parse(r.expiresAt)<=Date.now())))errors.push('ลิงก์ไม่ถูกต้อง หมดอายุ หรือใช้แล้ว กรุณาขอฟอร์มใหม่ใน LINE');if(!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(f.requestToken))errors.push('รูปแบบลิงก์ไม่ถูกต้อง');if(!f.fullName||f.fullName.length>200)errors.push('กรุณากรอกชื่อ ไม่เกิน 200 ตัวอักษร');if(!f.addressLine||f.addressLine.length>500)errors.push('กรุณากรอกที่อยู่ ไม่เกิน 500 ตัวอักษร');if(!/^0[689]\\d{8}$/.test(f.phone))errors.push('กรุณากรอกมือถือ 10 หลัก ขึ้นต้น 06, 08 หรือ 09');if(!/^\\d{2}$/.test(f.provinceCode)||!/^\\d{4}$/.test(f.districtCode)||!/^\\d{6}$/.test(f.subdistrictCode)||!/^\\d{5}$/.test(f.postalCode))errors.push('กรุณาเลือกข้อมูลพื้นที่ให้ครบ');return [{json:{...f,replay,valid:!errors.length,validationErrors:errors.join('\\n')},pairedItem:{item:0}}];"
      }
    },
