        "jsCode": "const c=$('Prepare LIFF Submission').item.json;const r=$input.first().json;const b=r.body||{};const valid=r.statusCode===200&&/^U[0-9a-f]{32}$/.test(String(b.sub||''))&&String(b.aud)===c.channelId;const {idToken,...safe}=c;return [{json:{...safe,lineUserId:valid?b.sub:'',identityValid:valid},pairedItem:{item:0}}];"
      }
