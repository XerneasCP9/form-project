      "parameters": {
        "jsCode": "const b=$input.first().json.body||{};const names=['fullName','addressLine','province','district','subdistrict','postalCode','phone','provinceCode','districtCode','subdistrictCode','dataVersion'];const f={};for(const k of names)f[k]=typeof b[k]==='string'?b[k].trim():'';const token=String(b.token||'');const channelId='';const formBaseUrl='';return [{json:{...f,requestToken:token,idToken:String(b.idToken||''),channelId,formBaseUrl,configured:!!channelId&&/^https:\\/\\//.test(formBaseUrl),submissionKey:token,lineUserId:'',rawPayload:JSON.stringify({...f,token}),validationStatus:'accepted',validationErrors:'',notificationStatus:'pending',submittedAt:new Date().toISOString(),isTest:['manual','test'].includes($execution.mode)}}];"
      }
