        "jsCode": "const f=$('Check Authoritative Geography').item.json;const r=$input.first().json;const saved=r.submissionKey===f.submissionKey&&r.validationStatus==='accepted'&&r.lineUserId===f.lineUserId;if(r.error)throw Error('Address lookup failed');if(f.replay&&!saved)throw Error('Submitted token missing saved address');return [{json:saved?{...f,...r,isTest:f.isTest,alreadySaved:true}:{...f,alreadySaved:false},pairedItem:{item:0}}];"
      }
